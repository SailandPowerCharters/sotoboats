:root{--navy:#082038;--navy2:#0d2b48;--gold:#caa35f;--gold2:#e2c48f;--ivory:#f6f2ea;--white:#fff;--ink:#173047;--muted:#6d7882;--line:#e6e6e1;--green:#3b9a6b;--orange:#c98a34;--red:#c95f5f}
*{box-sizing:border-box}body{margin:0;font-family:"DM Sans",sans-serif;background:#f4f2ee;color:var(--ink)}button,input,select,textarea{font:inherit}.hidden{display:none!important}
.app-shell{display:grid;grid-template-columns:250px 1fr;min-height:100vh}.sidebar{background:linear-gradient(180deg,#062039,#0b2c49);color:#fff;padding:28px 18px;display:flex;flex-direction:column;gap:25px}.portal-brand{display:flex;gap:12px;align-items:center;color:#fff;text-decoration:none;padding:0 8px}.brand-anchor{font-size:34px;color:var(--gold2)}.portal-brand strong{font-family:"Playfair Display",serif;letter-spacing:.14em;display:block}.portal-brand small{display:block;color:var(--gold2);letter-spacing:.2em;font-size:9px;margin-top:3px}.sidebar nav{display:grid;gap:8px}.nav-item,.logout-btn{border:0;background:transparent;color:#d9e2e8;text-align:left;padding:13px 14px;border-radius:12px;cursor:pointer;font-weight:600}.nav-item{display:flex;gap:12px;align-items:center}.nav-item.active,.nav-item:hover{background:linear-gradient(90deg,#b98a48,#8f6735);color:#fff}.sidebar-card{margin-top:auto;padding:20px;border-radius:16px;background:linear-gradient(160deg,#123f68,#0b2741);border:1px solid rgba(255,255,255,.08)}.sidebar-card span{font-size:9px;letter-spacing:.18em;color:var(--gold2)}.sidebar-card strong{display:block;font:24px "Playfair Display",serif;margin:7px 0}.sidebar-card p{color:#cbd6dd;font-size:12px;line-height:1.6}.logout-btn{border:1px solid rgba(255,255,255,.12);text-align:center}
.main{min-width:0}.login-screen{min-height:100vh;display:grid;place-items:center;padding:30px;background:linear-gradient(rgba(8,32,56,.48),rgba(8,32,56,.72)),url("https://images.pexels.com/photos/8436330/pexels-photo-8436330.jpeg?auto=compress&cs=tinysrgb&w=1800") center/cover}.login-card{width:min(900px,100%);display:grid;grid-template-columns:1.2fr .8fr;background:#fff;border-radius:24px;overflow:hidden;box-shadow:0 30px 90px rgba(0,0,0,.25)}.login-copy{padding:58px;background:var(--navy);color:#fff}.eyebrow{font-size:10px;letter-spacing:.2em;font-weight:800;color:var(--gold);margin:0 0 12px}.login-copy h1{font:48px/1.02 "Playfair Display",serif;margin:0 0 20px}.login-copy p:last-child{color:#cad5dd;line-height:1.7}.login-card form{padding:58px 42px;display:grid;align-content:center;gap:16px}.login-card label,.stack-form label,.dialog-card label{display:grid;gap:7px;font-size:12px;font-weight:700}.login-card input,.stack-form input,.dialog-card input,.dialog-card select,.dialog-card textarea,.stack-form select{padding:12px 13px;border:1px solid #d9dee2;border-radius:10px;outline:0;background:#fbfbfa}.login-card button,.stack-form button,.primary-btn{border:0;border-radius:10px;background:var(--gold);color:#12283d;padding:13px 18px;font-weight:800;cursor:pointer}.login-message,.form-message{font-size:12px;color:var(--red)}
.portal-screen{padding:0 28px 40px}.topbar{display:flex;justify-content:space-between;align-items:end;gap:25px;padding:36px 8px 22px}.topbar h1{font:48px/1 "Playfair Display",serif;margin:0}.topbar p:last-child{color:var(--muted)}.top-actions{display:flex;gap:12px;align-items:center}.status-pill{background:#e7f5ed;color:#24774f;padding:9px 13px;border-radius:999px;font-size:11px;font-weight:800}.user-chip{display:flex;gap:10px;align-items:center;background:#fff;border:1px solid var(--line);padding:7px 12px;border-radius:999px}.user-chip>span{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:var(--navy);color:#fff}.user-chip strong,.user-chip small{display:block}.user-chip small{font-size:10px;color:var(--muted)}.view{display:none}.view.active{display:block}.hero-panel{min-height:240px;border-radius:22px;padding:38px;display:flex;justify-content:space-between;align-items:end;gap:20px;background:linear-gradient(90deg,rgba(6,32,55,.92),rgba(6,32,55,.3)),url("https://images.pexels.com/photos/237272/pexels-photo-237272.jpeg?auto=compress&cs=tinysrgb&w=1600") center/cover;color:#fff;overflow:hidden}.hero-kicker{font-size:10px;letter-spacing:.18em;color:var(--gold2);font-weight:800}.hero-copy h2{font:46px/1 "Playfair Display",serif;margin:8px 0 10px}.hero-copy p{color:#d4dde3;max-width:570px}.hero-quote{font:32px/1.1 "Playfair Display",serif;color:var(--gold2);text-align:right}
.dashboard-grid{display:grid;grid-template-columns:1.4fr .85fr .65fr;gap:18px;margin-top:18px}.card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:22px;box-shadow:0 10px 30px rgba(15,37,54,.04)}.card-large{grid-row:span 2}.card-heading{display:flex;justify-content:space-between;gap:15px;align-items:start;margin-bottom:15px}.card h3,.section-head h2,.dialog-card h3{font-family:"Playfair Display",serif;margin:0;font-size:25px}.tag{font-size:9px;font-weight:800;letter-spacing:.14em}.tag.gold{color:#8f6427}.link-btn{border:0;background:none;color:#194b78;cursor:pointer;font-weight:700}.empty-state{padding:20px 0;color:var(--muted)}.performance-card{background:linear-gradient(145deg,#0c3151,#061f36);color:#fff}.performance-card span{color:var(--gold2);font-size:10px;letter-spacing:.16em}.performance-card strong{display:block;font:32px/1.05 "Playfair Display",serif;margin:18px 0}.performance-card p{color:#d2dde4;line-height:1.6}.op-mini{display:grid;grid-template-columns:160px 1fr;gap:18px;align-items:center}.op-mini img{width:160px;height:130px;object-fit:cover;border-radius:14px}.op-mini h4{font:24px "Playfair Display",serif;margin:0 0 8px}.meta-row{display:flex;gap:12px;flex-wrap:wrap;color:#576675;font-size:12px}.bid-now{margin-top:15px;border:0;background:var(--gold);padding:11px 16px;border-radius:10px;font-weight:800;cursor:pointer}.boat-mini{display:grid;grid-template-columns:95px 1fr;gap:12px}.boat-mini img{width:95px;height:70px;object-fit:cover;border-radius:10px}.boat-mini strong{display:block}.boat-mini small{color:var(--muted)}.availability-list,.bid-list{display:grid;gap:9px}.status-row{display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid var(--line);font-size:12px}.status-row:last-child{border-bottom:0}.badge{padding:5px 8px;border-radius:999px;font-size:10px;font-weight:800}.badge.green{background:#e6f4ec;color:#24794f}.badge.orange{background:#f8eedf;color:#9b671d}.badge.blue{background:#e7eef5;color:#315f85}.section-head{display:flex;justify-content:space-between;align-items:end;margin:5px 0 22px}.section-head h2{font-size:42px}.section-head p:last-child{color:var(--muted)}.split-layout{display:grid;grid-template-columns:420px 1fr;gap:18px}.stack-form{display:grid;gap:13px}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:12px}.boats-grid,.opportunity-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.boat-card,.opportunity-card{background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden}.boat-card img{height:180px;object-fit:cover}.boat-card .body,.opportunity-card .body{padding:18px}.boat-card h3,.opportunity-card h3{font:25px "Playfair Display",serif;margin:0 0 8px}.boat-card p,.opportunity-card p{color:var(--muted);line-height:1.5}.availability-manager{display:grid;gap:16px}.availability-boat{background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px}.availability-weeks{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:15px}.week-box{padding:14px;border:1px solid var(--line);border-radius:12px}.week-box strong{display:block;margin-bottom:8px}.week-box select{width:100%;padding:8px;border:1px solid var(--line);border-radius:8px}.bids-table{width:100%;border-collapse:collapse}.bids-table th,.bids-table td{text-align:left;padding:12px;border-bottom:1px solid var(--line);font-size:12px}.bids-table th{color:var(--muted);font-size:10px;letter-spacing:.08em}dialog{border:0;border-radius:18px;padding:0;box-shadow:0 30px 100px rgba(0,0,0,.35)}dialog::backdrop{background:rgba(4,18,30,.65)}.dialog-card{width:min(620px,92vw);padding:30px;display:grid;gap:13px}.dialog-close{justify-self:end;border:0;background:none;font-size:28px;cursor:pointer}.check-row{display:flex!important;grid-template-columns:auto 1fr!important;align-items:center}.check-row input{width:auto}.form-message{min-height:18px}
@media(max-width:1100px){.app-shell{grid-template-columns:92px 1fr}.portal-brand div:last-child,.nav-item span,.sidebar-card{display:none}.sidebar{align-items:center}.dashboard-grid{grid-template-columns:1fr 1fr}.card-large{grid-column:1/-1;grid-row:auto}.split-layout{grid-template-columns:1fr}.boats-grid{grid-template-columns:1fr 1fr}}@media(max-width:760px){.app-shell{display:block}.sidebar{position:sticky;top:0;z-index:20;display:flex;flex-direction:row;padding:10px;overflow:auto}.portal-brand,.sidebar-card,.logout-btn{display:none}.sidebar nav{display:flex}.nav-item{white-space:nowrap}.portal-screen{padding:0 14px 25px}.topbar{align-items:start}.top-actions{display:none}.dashboard-grid,.boats-grid,.opportunity-grid{grid-template-columns:1fr}.hero-panel{min-height:280px}.hero-quote{display:none}.two-col,.availability-weeks{grid-template-columns:1fr}.login-card{grid-template-columns:1fr}.login-copy{padding:38px}.login-card form{padding:34px}.op-mini{grid-template-columns:1fr}.op-mini img{width:100%;height:180px}}
